CREATE TABLE public.archives (
    archive_id     BIGSERIAL PRIMARY KEY,
    file_id        BIGINT REFERENCES public.raw_files(file_id),
    archived_on    TIMESTAMPTZ DEFAULT now(),
    total_records  INTEGER
);

CREATE TABLE file_parse_stats (
    stat_id SERIAL PRIMARY KEY,
    file_id INTEGER UNIQUE NOT NULL,
    total_logs INTEGER NOT NULL DEFAULT 0,
    parsed_logs INTEGER NOT NULL DEFAULT 0,
    skipped_logs INTEGER NOT NULL DEFAULT 0,
    parsed_percentage INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (file_id) REFERENCES raw_files(file_id) ON DELETE CASCADE
);


CREATE OR REPLACE FUNCTION public.archive_old_files()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO public.archives (file_id, archived_on, total_records)
    SELECT rf.file_id, now(), COUNT(le.log_id)
    FROM public.raw_files rf
    LEFT JOIN public.log_entries le ON le.file_id = rf.file_id
    WHERE rf.uploaded_at < now() - interval '90 days'
      AND rf.is_archived = false
    GROUP BY rf.file_id;

    UPDATE public.raw_files
    SET is_archived = true
    WHERE uploaded_at < now() - interval '90 days'
      AND is_archived = false;

    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_archive_files
AFTER INSERT ON public.raw_files
FOR EACH STATEMENT
EXECUTE FUNCTION public.archive_old_files();

-- ADMIN → all permissions
INSERT INTO public.role_permissions (role_id, permission_id)
SELECT r.role_id, p.permission_id
FROM public.roles r, public.permissions p
WHERE r.role_name = 'ADMIN'
ON CONFLICT DO NOTHING;

-- USER → limited permissions
INSERT INTO public.role_permissions (role_id, permission_id)
SELECT r.role_id, p.permission_id
FROM public.roles r
JOIN public.permissions p
ON p.permission_key IN ('UPLOAD_LOG','VIEW_LOG')
WHERE r.role_name = 'USER'
ON CONFLICT DO NOTHING;

