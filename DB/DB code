CREATE TABLE public.raw_files (
    file_id           BIGSERIAL PRIMARY KEY,
    team_id           BIGINT REFERENCES public.teams(team_id),
    uploaded_by       BIGINT REFERENCES public.users(user_id),
    original_name     VARCHAR(255) NOT NULL,
